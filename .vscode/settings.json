{
  // Dart default line length is 80 — the official recommendation.
  // Do NOT change this value. It matches `dart format` defaults and CI enforcement.
  "dart.lineLength": 80,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  // Point the Dart extension at the FVM SDK for this project, so the editor
  // analyzes with the same Flutter as the CLI. `fvm use` writes the pinned
  // version here instead (".fvm/versions/<v>"); the stable "flutter_sdk"
  // symlink means a version bump only touches .fvmrc, not this file.
  "dart.flutterSdkPath": ".fvm/flutter_sdk"
}
